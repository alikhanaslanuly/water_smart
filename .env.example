# Copy to .env and replace the placeholder values. Never commit .env.

# Backend
DATABASE_URL=postgres://drainage:change-me@localhost:5432/drainage?sslmode=disable
HTTP_ADDR=:8080
DEVICE_API_KEY=change-me-device-key
ADMIN_API_KEY=change-me-admin-key

# Offline timeout and reporting interval (seconds)
OFFLINE_TIMEOUT_SEC=15
REPORT_INTERVAL_SEC=5

# Simulator / device (placeholders only)
API_BASE_URL=http://localhost:8080/api/v1
DEVICE_ID=esp32-001
WIFI_SSID=your-wifi-name
WIFI_PASSWORD=your-wifi-password
